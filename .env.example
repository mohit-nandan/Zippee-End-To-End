# Copy this file to .env and fill in real values — NEVER commit .env
# Set ENV to: staging | preprod | prod

ENV=staging

# ===== STAGING =====
STAGING_BASE_URL=https://staging.zfwhospitality.in
STAGING_ADMIN_USER=your-staging-email@example.com
STAGING_ADMIN_PASS=your-staging-password
STAGING_DB_HOST=staging-db.your-rds.ap-south-1.rds.amazonaws.com
STAGING_DB_USER=dev
STAGING_DB_PASSWORD=your-staging-db-password
STAGING_DB_NAME=staging
STAGING_DB_PORT=3306
STAGING_CLICKPOST_API_KEY=clickpost_stg_your_key_here
STAGING_CLICKPOST_SHIPMENT_API_USERNAME=your@email.com
STAGING_CLICKPOST_SHIPMENT_API_PASSWORD=your-password
STAGING_UNIWARE_API_URL=https://
STAGING_EASYCOM_API_URL=https://

# ===== PREPROD =====
PREPROD_BASE_URL=https://beta.zfwhospitality.in
PREPROD_ADMIN_USER=your-preprod-email@example.com
PREPROD_ADMIN_PASS=your-preprod-password
PREPROD_DB_HOST=preprod-db.your-rds.ap-south-1.rds.amazonaws.com
PREPROD_DB_USER=root
PREPROD_DB_PASSWORD=your-preprod-db-password
PREPROD_DB_NAME=django_zfw
PREPROD_DB_PORT=3306
PREPROD_CLICKPOST_API_KEY=clickpost_preprod_your_key_here
PREPROD_CLICKPOST_SHIPMENT_API_USERNAME=your@email.com
PREPROD_CLICKPOST_SHIPMENT_API_PASSWORD=your-password
PREPROD_UNIWARE_API_URL=https://
PREPROD_EASYCOM_API_URL=https://

# ===== PROD =====
PROD_BASE_URL=https://blaze.zippee.delivery
PROD_ADMIN_USER=your-prod-email@example.com
PROD_ADMIN_PASS=your-prod-password
PROD_DB_HOST=prod-aurora-cluster.cluster-your-rds.ap-south-1.rds.amazonaws.com
PROD_DB_USER=testing
PROD_DB_PASSWORD=your-prod-db-password
PROD_DB_NAME=django_zfw
PROD_DB_PORT=3306
PROD_X_API_KEY=your-x-api-key-here
PROD_CLICKPOST_API_KEY=clickpost_prod_your_key_here
PROD_CLICKPOST_SHIPMENT_API_USERNAME=your@email.com
PROD_CLICKPOST_SHIPMENT_API_PASSWORD=your-password
PROD_UNIWARE_API_URL=https://
PROD_EASYCOM_API_URL=https://

# ===== APPIUM (Mobile) =====
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_UDID=emulator-5554
IOS_UDID=your-ios-device-udid
