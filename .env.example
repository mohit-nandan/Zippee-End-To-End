# Copy this file to .env and fill in real values — never commit .env

# Internal API
INTERNAL_API_URL=https://api-staging.zippee.in
INTERNAL_API_TOKEN=your-token-here

# Dashboard
DASHBOARD_URL=https://dashboard-staging.zippee.in
DASHBOARD_USER=your-email@zippee.in
DASHBOARD_PASSWORD=your-password

# WMS
UNIWARE_API_URL=https://...
UNIWARE_API_TOKEN=
EASYCOM_API_URL=https://...
EASYCOM_API_TOKEN=
CLICKPOST_API_URL=https://...
CLICKPOST_API_TOKEN=

# Appium
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_UDID=emulator-5554
IOS_UDID=your-ios-udid

# Environment: staging | prod
ENV=staging
